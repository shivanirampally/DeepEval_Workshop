# Copy this file to .env and fill in the values you need.
# .env is already git-ignored - never commit real keys.

# Only required when project_config.json's models.judge_provider is "gemini".
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only required when project_config.json's models.judge_provider is "anthropic".
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
